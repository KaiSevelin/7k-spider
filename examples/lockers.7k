// The locker estate: doors, and the hardware that opens them.
//
// This is where the lossy pipe is. A door sensor reports constantly and nothing may depend on
// those reports for progress — which is a claim the language can express and the graph can draw.

package parcel.lockers

import parcel.common

envelopes common.Trace, common.Operator

// ---------------------------------------------------------------- messages

message OpenDoor v1.0 @command {
  parcelRef: common.ParcelRef @role(businessKey)
  locker:    common.LockerId
  door:      common.DoorId
}

message DoorOpened v1.0 @event {
  parcelRef: common.ParcelRef @role(businessKey)
  locker:    common.LockerId
  door:      common.DoorId
}

// The hardware refused. A separate outcome rather than an error, because a jammed door is a
// normal thing for a locker network to have and a saga has to be able to react to it.
message DoorJammed v1.0 @event {
  parcelRef: common.ParcelRef @role(businessKey)
  locker:    common.LockerId
  door:      common.DoorId
  detail:    string { length 1..200 }
}

// Door sensors, continuously. Carried on a lossy pipe on purpose.
message DoorSensed v1.0 @event {
  locker: common.LockerId @role(businessKey)
  door:   common.DoorId
  open:   bool
}

// ---------------------------------------------------------------- pipes

// Hardware commands. A door is a physical thing, so ordering per locker matters: two opens for one
// locker must not cross.
pipe commands : queue {
  ordering by operatorId
  carries   OpenDoor
}

pipe events : topic {
  ordering  by operatorId
  retention 7d
}

// Fire and forget. A sensor reading that is lost is a sensor reading; nothing waits for one, and
// there is nowhere to dead-letter it to. Drawn dashed by Spider for exactly that reason.
pipe telemetry : topic {
  delivery at-most-once
  dlq      none
}

// ---------------------------------------------------------------- services

// The physical estate. Not generated by 7K — only the connection is modelled, because messages
// cross it. Spider draws it as a boundary marker rather than as a service.
service DoorController @external {
  // Two different lossinesses, side by side. The pipe is `at-most-once`, so a reading that is *sent* may
  // be lost in transit; the publication is `best-effort`, so one may never be sent at all. Nothing waits
  // for a door sensor reading either way, which is what makes both honest here (`03-topology.md` 2.9).
  emits DoorSensed to telemetry best-effort
  emits DoorOpened to events
  emits DoorJammed to events

  reacts OpenDoor from commands {
    replies DoorOpened | DoorJammed
  }
}

// Watches the estate. Reads the lossy pipe, and depends on it for nothing.
service EstateMonitor {
  reacts DoorSensed from telemetry {
    // No business identity: each reading is genuinely distinct, and replaying one changes only a
    // cached figure.
    once per none
    replies none
  }

  reacts DoorJammed from events {
    replies none
  }
}
