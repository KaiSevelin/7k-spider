// Scenarios for the shop, written to be watched rather than only to pass.
//
// Each one exercises something a different view has to show: a happy path for the sequence diagram, two
// days of silence for the timeline, a stage half-unwound for the saga view, and the nightly sweep for a
// schedule whose missed occurrences are deliberately not caught up.

scenarios for shop.orders

// ---------------------------------------------------------------------------
// A baseline. Scenarios inherit it and override only what they are testing.
// ---------------------------------------------------------------------------

mockset Working {
  mock catalog.CatalogService {
    on catalog.ReserveStock reply catalog.StockReserved after 200ms
    on catalog.ReleaseStock reply catalog.StockReleased after 200ms
  }
  // Faster than the shelf on purpose: the branch declared second finishes first, so the trace shows a
  // stage joining out of declaration order.
  mock payments.PaymentService {
    on payments.AuthorisePayment reply payments.PaymentAuthorised {
      total: { amount: "348.00", currency: "SEK" }
    } after 100ms
    on payments.VoidAuthorisation reply payments.AuthorisationVoided after 100ms
  }
  mock SweepService {
    on SweepAbandoned reply SweepFinished { cleared: 4 } after 2s
  }
}

// ---------------------------------------------------------------------------
// 1. The happy path: placed, stock held while the card is authorised, shipped.
// ---------------------------------------------------------------------------

scenario OrderShipsSameDay {
  seed 1
  use  Working

  at 0s publish PlaceOrder as Storefront
    with claims   { sub: "cust-5512", scope: "orders.place" }
    with envelope { shopId: "nordbok", actor: "cust-5512" }
    {
      orderRef: "ORD-77301",
      customer: {
        name:    "Nils Hammar",
        email:   "nils@example.com",
        address: "Vastra Hamngatan 14, 411 17 Goteborg"
      },
      lines: [
        { sku: "BK-1194", quantity: 2, price: { amount: "149.00", currency: "SEK" } },
        { sku: "BK-2201", quantity: 1, price: { amount: "50.00",  currency: "SEK" } }
      ],
      total: { amount: "348.00", currency: "SEK" }
    }

  expect  OrderPlaced             on events
  expect  catalog.ReserveStock    on catalog.commands
  expect  payments.AuthorisePayment on payments.commands
  advance 1s
  expect  ShipOrder on commands

  // The warehouse picks it the same afternoon.
  at 6h publish OrderShipped as Warehouse
    with envelope { shopId: "nordbok", actor: "cust-5512" }
    { orderRef: "ORD-77301" }

  advance 1s
  expect saga Fulfilment["ORD-77301"].state == complete
  expect OrderClosed on events
}

// ---------------------------------------------------------------------------
// 2. The card is declined after the stock was already held. The branch that
//    succeeded is unwound - which only a stage can arrange.
// ---------------------------------------------------------------------------

scenario CardDeclined {
  seed 2
  use  Working

  mock payments.PaymentService {
    on payments.AuthorisePayment reply payments.PaymentDeclined {
      detail: "insufficient funds"
    } after 400ms
  }

  at 0s publish PlaceOrder as Storefront
    with claims   { sub: "cust-5512", scope: "orders.place" }
    with envelope { shopId: "nordbok", actor: "cust-5512" }
    {
      orderRef: "ORD-77302",
      customer: {
        name:    "Bea Lindqvist",
        email:   "bea@example.com",
        address: "Storgatan 2, 111 51 Stockholm"
      },
      lines: [{ sku: "BK-1194", quantity: 1, price: { amount: "149.00", currency: "SEK" } }],
      total: { amount: "149.00", currency: "SEK" }
    }

  advance 1s

  // `reserve` completed at 200ms; `authorise` was declined at 400ms. So the stock goes back, and nothing
  // is ever picked.
  expect catalog.ReleaseStock on catalog.commands
  expect no ShipOrder on commands
  expect saga Fulfilment["ORD-77302"].state == reject
  expect OrderClosed on events
}

// ---------------------------------------------------------------------------
// 3. The last one sold while the basket was open. Refused before any money moves.
// ---------------------------------------------------------------------------

scenario OutOfStock {
  seed 3

  mock catalog.CatalogService {
    on catalog.ReserveStock reply catalog.OutOfStock { sku: "BK-1194" } after 200ms
  }
  // Answers later than the shelf refuses, so the rejection arrives while this branch is still waiting -
  // and its 30s timeout must never fire, because the saga is already over.
  mock payments.PaymentService {
    on payments.AuthorisePayment reply payments.PaymentAuthorised {
      total: { amount: "149.00", currency: "SEK" }
    } after 5s
    on payments.VoidAuthorisation reply payments.AuthorisationVoided after 100ms
  }

  at 0s publish PlaceOrder as Storefront
    with claims   { sub: "cust-5512", scope: "orders.place" }
    with envelope { shopId: "nordbok", actor: "cust-5512" }
    {
      orderRef: "ORD-77303",
      customer: {
        name:    "Carl Oren",
        email:   "carl@example.com",
        address: "Kungsgatan 9, 753 21 Uppsala"
      },
      lines: [{ sku: "BK-1194", quantity: 1, price: { amount: "149.00", currency: "SEK" } }],
      total: { amount: "149.00", currency: "SEK" }
    }

  advance 1s
  expect saga Fulfilment["ORD-77303"].state == reject
  expect no ShipOrder on commands
}

// ---------------------------------------------------------------------------
// 4. Nobody picks it. Two days of nothing, then the ship step times out and both
//    halves of the stage are unwound - the only run here where two undos run.
// ---------------------------------------------------------------------------

scenario NothingShipped {
  seed 4
  use  Working

  at 0s publish PlaceOrder as Storefront
    with claims   { sub: "cust-5512", scope: "orders.place" }
    with envelope { shopId: "nordbok", actor: "cust-5512" }
    {
      orderRef: "ORD-77304",
      customer: {
        name:    "Disa Franzen",
        email:   "disa@example.com",
        address: "Sodra Vagen 31, 412 54 Goteborg"
      },
      lines: [{ sku: "BK-2201", quantity: 3, price: { amount: "50.00", currency: "SEK" } }],
      total: { amount: "150.00", currency: "SEK" }
    }

  advance 1s
  expect ShipOrder on commands

  // Past the ship step's 48h timeout, and nothing arrives.
  advance 49h
  expect catalog.ReleaseStock       on catalog.commands
  expect payments.VoidAuthorisation on payments.commands
  expect saga Fulfilment["ORD-77304"].state == reject
  expect OrderClosed on events
}

// ---------------------------------------------------------------------------
// 5. An order placed without the scope for it. Refused before the handler runs,
//    and never retried: a rejection is not a failure.
// ---------------------------------------------------------------------------

scenario PlaceWithoutScope {
  seed 5
  use  Working

  at 0s publish PlaceOrder as Storefront
    with claims   { sub: "cust-5512", scope: "orders.read" }
    with envelope { shopId: "nordbok", actor: "cust-5512" }
    {
      orderRef: "ORD-77305",
      customer: {
        name:    "Erik Palm",
        email:   "erik@example.com",
        address: "Nygatan 4, 582 19 Linkoping"
      },
      lines: [{ sku: "BK-1194", quantity: 1, price: { amount: "149.00", currency: "SEK" } }],
      total: { amount: "149.00", currency: "SEK" }
    }

  advance 1s
  expect rejected PlaceOrder at OrderService reason unauthorized
}

// ---------------------------------------------------------------------------
// 6. The nightly sweep, three nights running. Twenty-four hour gaps, which the
//    timeline marks and the transport does not wait for.
// ---------------------------------------------------------------------------

scenario SweepRunsNightly {
  seed 6
  use  Working

  advance 72h
  expect SweepAbandoned on commands count 3
  expect SweepFinished  on events   count 3
}

// ---------------------------------------------------------------------------
// 7. The catalogue does not answer at all. The reserve step's own timeout fires,
//    which is a different thing from the saga's week-long deadline.
// ---------------------------------------------------------------------------

scenario CatalogueNeverAnswers {
  seed 7

  mock catalog.CatalogService {
    on catalog.ReserveStock hang
  }
  mock payments.PaymentService {
    on payments.AuthorisePayment reply payments.PaymentAuthorised {
      total: { amount: "149.00", currency: "SEK" }
    } after 100ms
    on payments.VoidAuthorisation reply payments.AuthorisationVoided after 100ms
  }

  at 0s publish PlaceOrder as Storefront
    with claims   { sub: "cust-5512", scope: "orders.place" }
    with envelope { shopId: "nordbok", actor: "cust-5512" }
    {
      orderRef: "ORD-77306",
      customer: {
        name:    "Frida Ask",
        email:   "frida@example.com",
        address: "Hamngatan 6, 211 22 Malmo"
      },
      lines: [{ sku: "BK-2201", quantity: 2, price: { amount: "50.00", currency: "SEK" } }],
      total: { amount: "100.00", currency: "SEK" }
    }

  advance 31s
  expect saga Fulfilment["ORD-77306"].state == reject
  // The money that was authorised while the shelf stayed silent is given straight back.
  expect payments.VoidAuthorisation on payments.commands
}
