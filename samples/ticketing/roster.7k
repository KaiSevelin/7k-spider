// Who is on duty, and who is free.
//
// This is where the lossy pipe is. An agent's console says "still here" every few seconds, and nothing
// may depend on those heartbeats for progress — a claim the language can express and the graph draws.

package support.roster

import support.common

envelopes common.Trace, common.Tenancy

// ---------------------------------------------------------------- messages

message ClaimAgent v1.0 @command {
  ticketRef: common.TicketRef @role(businessKey)
  team:      common.TeamRef
  priority:  common.Priority
}

message AgentClaimed v1.0 @event {
  ticketRef:  common.TicketRef @role(businessKey)
  assignment: common.Assignment
}

// Nobody free on that team. An outcome rather than an error, because a desk with everyone busy is a
// normal thing for a desk to be, and the saga has to be able to react to it.
message NoAgentAvailable v1.0 @event {
  ticketRef: common.TicketRef @role(businessKey)
  team:      common.TeamRef
}

// The inverse of a claim. Taken back when the process that asked for an agent cannot continue.
message ReleaseAgent v1.0 @command {
  ticketRef:  common.TicketRef @role(businessKey)
  assignment: common.Assignment
}

message AgentReleased v1.0 @event {
  ticketRef: common.TicketRef @role(businessKey)
}

// A console saying it is still open, continuously. Carried on a lossy pipe on purpose.
message AgentPresence v1.0 @event {
  agent:     common.AgentRef @role(businessKey)
  team:      common.TeamRef
  available: bool
}

// ---------------------------------------------------------------- pipes

// Claiming is a contention point: two claims for one tenant must not cross, or the same agent is handed
// to two tickets.
pipe commands : queue {
  ordering by tenantId
  carries   ClaimAgent, ReleaseAgent
}

pipe events : topic {
  ordering  by tenantId
  retention 7d
}

// Fire and forget. A heartbeat that is lost is a heartbeat; the next one is along in seconds, and there
// is nowhere to dead-letter it to. Drawn dashed by Spider for exactly that reason.
pipe presence : topic {
  delivery at-most-once
  dlq      none
}

// ---------------------------------------------------------------- services

// The agent's own console. Not generated by 7K — only the connection is modelled, because messages
// cross it. Spider draws it as a boundary marker rather than as a service.
service AgentApp @external {
  // Two different lossinesses, side by side. The pipe is `at-most-once`, so a heartbeat that is *sent*
  // may be lost in transit; the publication is `best-effort`, so one may never be sent at all. Nothing
  // waits for a heartbeat either way, which is what makes both honest here (`03-topology.md` 2.9).
  emits AgentPresence to presence best-effort
}

// Owns who is free. Its own service because an agent is a scarce resource and whoever hands them out
// has to be the only thing that does.
service RosterService {
  emits AgentClaimed     to events
  emits NoAgentAvailable to events
  emits AgentReleased    to events

  reacts ClaimAgent from commands {
    once per ticketRef
    replies AgentClaimed | NoAgentAvailable
  }

  reacts ReleaseAgent from commands {
    once per ticketRef
    replies AgentReleased
  }

  // Availability, read off the lossy pipe and depended on for nothing: a missed heartbeat makes an
  // agent look busy, which costs a claim and never a ticket.
  reacts AgentPresence from presence {
    // No business identity worth deduplicating: each heartbeat is genuinely distinct, and replaying one
    // changes only a cached figure.
    once per none
    replies none
  }
}

// Watches the floor. Reads the lossy pipe, and depends on it for nothing.
service PresenceMonitor {
  reacts AgentPresence from presence {
    once per none
    replies none
  }
}
