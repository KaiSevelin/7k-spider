{
  "name": "@sevenk/spider",
  "version": "0.1.0",
  "description": "Graph, sequence and timeline views over a 7K model and its traces",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/KaiSevelin/7k-spider.git"
  },
  "homepage": "https://github.com/KaiSevelin/7k-spider#readme",
  "bugs": {
    "url": "https://github.com/KaiSevelin/7k-spider/issues"
  },
  "keywords": [
    "7k",
    "spider",
    "graph",
    "sequence-diagram",
    "message-driven"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "typecheck": "tsc --build --force && tsc -p tsconfig.test.json",
    "serve": "tsx src/cli.ts serve",
    "demo": "tsx src/cli.ts serve examples --trace examples/handover.ndjson",
    "trace": "tsx scripts/trace.ts"
  },
  "dependencies": {
    "@sevenk/core": "file:../7K/packages/core",
    "@sevenk/generate": "file:../7K/packages/generate",
    "cytoscape": "^3.34.3",
    "cytoscape-elk": "^2.3.0",
    "elkjs": "^0.12.0"
  },
  "devDependencies": {
    "@sevenk/bicep": "file:../7k-bicep",
    "@sevenk/csharp": "file:../7k-csharp",
    "@sevenk/node": "file:../7k-node",
    "@sevenk/sqlserver": "file:../7k-sqlserver",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "bin": {
    "spider": "./dist/cli.js"
  }
}
